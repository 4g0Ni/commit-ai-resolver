# Local server (binds to this machine only by default)
HOST=127.0.0.1
PORT=4399

# Optional OpenAI-compatible API. Static dashboard/API routes work without it.
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_EMBEDDING_API_KEY=local
# OPENAI_EMBEDDING_DIMENSIONS=1024

# Agent orchestration rollout. workflow preserves the fixed baseline;
# multi_agent enables the LLM supervisor; auto uses multi-agent for RCA/incident queries.
AGENT_ORCHESTRATION_MODE=workflow
# AGENT_LEGACY_FALLBACK=1
# AGENT_SUPERVISOR_MAX_TURNS=8
# AGENT_MAX_CALLS=6
# AGENT_MAX_TOOL_CALLS=14
# AGENT_MAX_DIFF_FETCHES=3
# AGENT_RUN_TIMEOUT_MS=75000
# Agents SDK remote tracing stays disabled; trajectories remain local.
OPENAI_AGENTS_DISABLE_TRACING=1

# Optional commit reranker. It is disabled by default and should be enabled only
# after provider-specific latency/cost validation.
# ENABLE_LLM_RERANKER=1
# LLM_RERANK_CANDIDATES=20
# LLM_RERANK_MODEL=gpt-4.1-mini

# Optional live Azure DevOps access. Existing local JSON/vector data works without it.
# ADO_PAT=
# ADO_BEARER_TOKEN=

# Live ADO refresh is opt-in so startup never requests external credentials.
# ENABLE_SCHEDULED_REFRESH=1

# Optional storage and CORS overrides.
# DATA_DIR=D:\path\to\commit-ai-data
# VECTORS_DB=D:\path\to\vectors.db
# ALLOWED_ORIGINS=https://localhost:5173
